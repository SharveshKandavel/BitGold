    "convex": "^1.31.7",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "^15.1.3",
    "otpauth": "^9.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/react": "^16.3.2",
